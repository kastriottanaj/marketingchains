---
import Base from './Base.astro';
import { company } from '../config/company';

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
---

<Base title={`${title} | ${company.legalName}`} description={description} path={path}>
  <section class="legal-hero theme-dark">
    <div class="container">
      <p class="eyebrow">Legal</p>
      <h1>{title}</h1>
      <p class="legal-hero__meta">Last updated: {company.legalPagesUpdated}</p>
    </div>
  </section>

  <div class="legal-body theme-light">
    <div class="container">
      <article class="prose">
        <slot />
      </article>
    </div>
  </div>
</Base>

<style>
  .legal-hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(48rem 24rem at 90% -20%, rgb(58 141 255 / 0.2), transparent 62%),
      linear-gradient(180deg, var(--navy-975), var(--navy-900));
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.25rem, 1.2rem + 3.4vw, 3.5rem);
    letter-spacing: -0.03em;
  }

  .legal-hero__meta {
    margin-top: 1rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .legal-body {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background: var(--white);
  }
</style>
