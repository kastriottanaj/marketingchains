---
import '../styles/fonts.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { company } from '../config/company';
// Preload the one font file every page needs, so text never flashes in a fallback face.
import plexSansLatin from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Path of this page (e.g. "/terms"). Used for the canonical URL. */
  path: string;
  /** Keep the page out of search indexes (used for the 404 page). */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;

// Absolute URLs need a known origin: set SITE_URL when building (see astro.config.mjs).
const canonical = !noindex && Astro.site ? new URL(path, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08111f" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={plexSansLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={company.legalName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
