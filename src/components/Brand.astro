---
import { company } from '../config/company';

interface Props {
  /** Size of the square logomark in px. */
  size?: number;
}

const { size = 32 } = Astro.props;
---

<a class="brand" href="/">
  <svg class="brand__mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#3a8dff" />
    <g transform="translate(16 16) rotate(-45)" fill="none" stroke="#08111f" stroke-width="2.4">
      <rect x="-12" y="-4" width="13" height="8" rx="4" />
      <rect x="-1" y="-4" width="13" height="8" rx="4" />
    </g>
  </svg>
  <span>{company.legalName}</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--white);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand__mark {
    flex: none;
  }
</style>
