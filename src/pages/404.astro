---
import Base from '../layouts/Base.astro';
import { company } from '../config/company';
---

<Base
  title={`Page not found | ${company.legalName}`}
  description="The page you requested could not be found."
  path="/404"
  noindex
>
  <section class="not-found theme-dark">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p>The page you requested doesn’t exist or has moved.</p>
      <a class="button" href="/">Back to the homepage</a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding-block: clamp(4rem, 12vw, 9rem);
    background:
      radial-gradient(48rem 24rem at 90% -20%, rgb(58 141 255 / 0.2), transparent 62%),
      linear-gradient(180deg, var(--navy-975), var(--navy-900));
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.25rem, 1.2rem + 3.4vw, 3.5rem);
    letter-spacing: -0.03em;
  }

  p:not(.eyebrow) {
    max-width: 32rem;
    margin-top: 1rem;
    font-size: 1.1875rem;
  }

  .button {
    margin-top: 2rem;
  }
</style>
