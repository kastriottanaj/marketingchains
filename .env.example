# Copy this file to ".env" on the server and fill it in. Never commit ".env".

# The domain visitors use, without https:// (HTTPS is set up automatically).
SITE_DOMAIN=example.com

# Contact form email delivery (see README, "Contact form"). Until these are
# set, the form politely says it cannot send.
RESEND_API_KEY=
CONTACT_FROM="Marketing Chains LLC <contact@your-verified-domain.com>"
# Where submissions go. Defaults to the contact email in src/config/company.ts.
# CONTACT_TO=info@visifluent.com
